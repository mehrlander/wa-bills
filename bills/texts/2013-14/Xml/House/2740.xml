<?xml version="1.0" encoding="utf-8"?><!DOCTYPE Bill PUBLIC "-//LSC//DTD Authoring Bill XML//EN" "billauthoring.top"><Bill version="1.0" type="introLN"><IntroducedBillHeader><RequestNumber>H-3579.2</RequestNumber><BillNumber>HOUSE BILL 2740</BillNumber><StateLegSession><State>State of Washington</State><Legislature>63rd Legislature</Legislature><Session>2014 Regular Session</Session></StateLegSession><Sponsors>Representative Moeller</Sponsors><IntroHistory><ReadDate>Read first time 01/29/14.  </ReadDate><ReferredTo>Referred to Committee on Transportation.</ReferredTo></IntroHistory></IntroducedBillHeader><BriefDescription>Modifying special permit fees for certain vehicle loads and movements.</BriefDescription><BillBody><BillTitle><LineNumber line=" 1" page="1,1" hrt="no" />	AN ACT Relating to overwidth, overheight, overweight, and overlegal<LineNumber line=" 2" page="1,2" />loads; amending RCW 46.44.0941; and providing an effective date.</BillTitle><EnactingClause><LineNumber line=" 3" page="1,3" hrt="no" />BE IT ENACTED BY THE LEGISLATURE OF THE STATE OF WASHINGTON:</EnactingClause><BillSection type="amend"><LineNumber line=" 4" page="1,4" hrt="no" /><BegSecAmd><SecNum>Sec. </SecNum><BegSecText>RCW <Cite>46.44.0941</Cite> and 2010 c 161 s 1117 are each amended to<LineNumber line=" 5" page="1,5" />read as follows:</BegSecText><LineNumber line=" 6" page="1,6" hrt="no" /></BegSecAmd><RCWSLText>	The following fees, in addition to the regular license and tonnage<LineNumber line=" 7" page="1,7" />fees, shall be paid for all movements under special permit made upon<LineNumber line=" 8" page="1,8" />state highways.  All funds collected, except the amount retained by<LineNumber line=" 9" page="1,9" />authorized agents of the department as provided in RCW 46.44.096, shall<LineNumber line="10" page="1,10" />be forwarded to the state treasury and shall be deposited in the motor<LineNumber line="11" page="1,11" />vehicle fund<add>.  Each fiscal biennium, five hundred thousand dollars of</add><LineNumber line="12" page="1,12" /><add>the fees collected under this section and deposited in the motor</add><LineNumber line="13" page="1,13" /><add>vehicle fund must be utilized by the department of transportation to</add><LineNumber line="14" page="1,14" /><add>implement and maintain an automated system that maintains a database of</add><LineNumber line="15" page="1,15" /><add>the state's bridge inventory and the associated structural designs,</add><LineNumber line="16" page="1,16" /><add>specifications, and weight limits.  When issuing a special permit for</add><LineNumber line="17" page="1,17" /><add>an overwidth, overweight, overheight, or overlegal load, the route must</add><LineNumber line="18" page="1,18" /><add>be checked by the automated system to ensure that the load will not</add><PageNumberFooter>		p. 1	HB 2740</PageNumberFooter><LineNumber line=" 1" page="2,1" hrt="no" /><add>cause damage or risk to the state's bridges.  Any remaining fees</add><LineNumber line=" 2" page="2,2" /><add>collected and deposited into the motor vehicle fund under this section</add><LineNumber line=" 3" page="2,3" /><add>must be used for highway preservation</add>:<paraend /><paraendLessSpace /><LineNumber line=" 4" page="2,4" hrt="no" />All overlegal loads, except overweight, single<paraend /><LineNumber line=" 5" page="2,5" hrt="no" />	trip<DotsRight />((<strike Parens="NoParens">$  10.00</strike>)) <add>$15.00</add><paraend /><LineNumber line=" 6" page="2,6" hrt="no" />Continuous operation of overlegal loads<paraend /><LineNumber line=" 7" page="2,7" hrt="no" />	having either overwidth or overheight<paraend /><LineNumber line=" 8" page="2,8" hrt="no" />	features only, for a period not to exceed<paraend /><LineNumber line=" 9" page="2,9" hrt="no" />	thirty days<DotsRight />((<strike Parens="NoParens">$  20.00</strike>)) <add>$55.00</add><paraend /><LineNumber line="10" page="2,10" hrt="no" />Continuous operations of overlegal loads<paraend /><LineNumber line="11" page="2,11" hrt="no" />	having overlength features only, for a<paraend /><LineNumber line="12" page="2,12" hrt="no" />	period not to exceed thirty days<DotsRight />((<strike Parens="NoParens">$  10.00</strike>)) <add>$28.00</add><paraend /><LineNumber line="13" page="2,13" hrt="no" />Continuous operation of a combination of<paraend /><LineNumber line="14" page="2,14" hrt="no" />	vehicles having one trailing unit that<paraend /><LineNumber line="15" page="2,15" hrt="no" />	exceeds fifty<hyphen />three feet and is not<paraend /><LineNumber line="16" page="2,16" hrt="no" />	more than fifty<hyphen />six feet in length, for<paraend /><LineNumber line="17" page="2,17" hrt="no" />	a period of one year<DotsRight />((<strike Parens="NoParens">$ 100.00</strike>)) <add>$174.00</add><paraend /><LineNumber line="18" page="2,18" hrt="no" />Continuous operation of a combination of<paraend /><LineNumber line="19" page="2,19" hrt="no" />	vehicles having two trailing units<paraend /><LineNumber line="20" page="2,20" hrt="no" />	which together exceed sixty<hyphen />one feet and<paraend /><LineNumber line="21" page="2,21" hrt="no" />	are not more than sixty<hyphen />eight feet in<paraend /><LineNumber line="22" page="2,22" hrt="no" />	length, for a period of one year<DotsRight />((<strike Parens="NoParens">$ 100.00</strike>)) <add>$174.00</add><paraend /><LineNumber line="23" page="2,23" hrt="no" />Continuous operation of a three<hyphen />axle fixed<paraend /><LineNumber line="24" page="2,24" hrt="no" />	load vehicle having less than 65,000<paraend /><LineNumber line="25" page="2,25" hrt="no" />	pounds gross weight, for a period not<paraend /><LineNumber line="26" page="2,26" hrt="no" />	to exceed thirty days<DotsRight />((<strike Parens="NoParens">$  70.00</strike>)) <add>$104.00</add><paraend /><LineNumber line="27" page="2,27" hrt="no" />Continuous operation of a four<hyphen />axle fixed load<paraend /><LineNumber line="28" page="2,28" hrt="no" />	vehicle meeting the requirements of<paraend /><LineNumber line="29" page="2,29" hrt="no" />	RCW 46.44.091(1) and weighing less than<paraend /><LineNumber line="30" page="2,30" hrt="no" />	86,000 pounds gross weight, not to exceed<paraend /><LineNumber line="31" page="2,31" hrt="no" />	thirty days<DotsRight />((<strike Parens="NoParens">$  90.00</strike>)) <add>$126.00</add><paraend /><LineNumber line="32" page="2,32" hrt="no" />Continuous movement of a mobile home or manufactured<paraend /><LineNumber line="33" page="2,33" hrt="no" />	home having nonreducible features not to<paraend /><LineNumber line="34" page="2,34" hrt="no" />	exceed eighty<hyphen />five feet in total length and<paraend /><LineNumber line="35" page="2,35" hrt="no" />	fourteen feet in width, for a period of<paraend /><LineNumber line="36" page="2,36" hrt="no" />	one year<DotsRight />((<strike Parens="NoParens">$ 150.00</strike>)) <add>$346.00</add><paraend /><LineNumber line="37" page="2,37" hrt="no" />Continuous operation of a class C tow truck or a<paraend /><LineNumber line="38" page="2,38" hrt="no" />	class E tow truck with a class C rating while<paraend /><PageNumberFooter>	HB 2740	p. 2	</PageNumberFooter><LineNumber line=" 1" page="3,1" hrt="no" />	performing emergency and nonemergency tows of<paraend /><LineNumber line=" 2" page="3,2" hrt="no" />	oversize or overweight, or both, vehicles and<paraend /><LineNumber line=" 3" page="3,3" hrt="no" />	vehicle combinations, under rules adopted by the<paraend /><LineNumber line=" 4" page="3,4" hrt="no" />	transportation commission, for a period of<paraend /><LineNumber line=" 5" page="3,5" hrt="no" />	one year<DotsRight />((<strike Parens="NoParens">$ 150.00</strike>)) <add>$179.00</add><paraend /><LineNumber line=" 6" page="3,6" hrt="no" />Continuous operation of a class B tow truck or a<paraend /><LineNumber line=" 7" page="3,7" hrt="no" />	class E tow truck with a class B rating while<paraend /><LineNumber line=" 8" page="3,8" hrt="no" />	performing emergency and nonemergency tows of<paraend /><LineNumber line=" 9" page="3,9" hrt="no" />	oversize or overweight, or both, vehicles and<paraend /><LineNumber line="10" page="3,10" hrt="no" />	vehicle combinations, under rules adopted by the<paraend /><LineNumber line="11" page="3,11" hrt="no" />	transportation commission, for a period of<paraend /><LineNumber line="12" page="3,12" hrt="no" />	one year<DotsRight />((<strike Parens="NoParens">$ 75.00</strike>)) <add>$90.00</add><paraend /><LineNumber line="13" page="3,13" hrt="no" />Continuous operation of a two or three<hyphen />axle<paraend /><LineNumber line="14" page="3,14" hrt="no" />	collection truck, actually engaged in the<paraend /><LineNumber line="15" page="3,15" hrt="no" />	collection of solid waste or recyclables,<paraend /><LineNumber line="16" page="3,16" hrt="no" />	or both, under chapter 81.77 or 35.21 RCW<paraend /><LineNumber line="17" page="3,17" hrt="no" />	or by contract under RCW 36.58.090, for<paraend /><LineNumber line="18" page="3,18" hrt="no" />	one year with an additional six thousand<paraend /><LineNumber line="19" page="3,19" hrt="no" />	pounds more than the weight authorized in<paraend /><LineNumber line="20" page="3,20" hrt="no" />	RCW 46.16A.455 on the rear axle of a two<hyphen />axle<paraend /><LineNumber line="21" page="3,21" hrt="no" />	truck or eight thousand pounds for the tandem<paraend /><LineNumber line="22" page="3,22" hrt="no" />	axles of a three<hyphen />axle truck.  RCW 46.44.041<paraend /><LineNumber line="23" page="3,23" hrt="no" />	and 46.44.091 notwithstanding, the tire limits<paraend /><LineNumber line="24" page="3,24" hrt="no" />	specified in RCW 46.44.042 apply, but none of<paraend /><LineNumber line="25" page="3,25" hrt="no" />	the excess weight is valid or may be permitted<paraend /><LineNumber line="26" page="3,26" hrt="no" />	on any part of the federal interstate highway<paraend /><LineNumber line="27" page="3,27" hrt="no" />	system<DotsRight />((<strike Parens="NoParens">$  42.00</strike>)) <add>$59.00</add><paraend /><LineNumber line="28" page="3,28" hrt="no" /><FlushRight />per thousand pounds<paraend /><paraendLessSpace /><LineNumber line="29" page="3,29" hrt="no" />	The department may issue any of the above<hyphen />listed permits that<LineNumber line="30" page="3,30" />involve height, length, or width for an expanded period of consecutive<LineNumber line="31" page="3,31" />months, not to exceed one year.<paraend /><LineNumber line="32" page="3,32" hrt="no" />	Continuous operation of farm implements under a permit issued as<LineNumber line="33" page="3,33" />authorized by RCW 46.44.140 by:<paraend /><paraendLessSpace /><LineNumber line="34" page="3,34" hrt="no" />(1) Farmers in the course of farming activities,<paraend /><LineNumber line="35" page="3,35" hrt="no" />	for any three<hyphen />month period<DotsRight />((<strike Parens="NoParens">$10.00</strike>)) <add>$25.00</add><paraend /><LineNumber line="36" page="3,36" hrt="no" />(2) Farmers in the course of farming activities,<paraend /><LineNumber line="37" page="3,37" hrt="no" />	for a period not to exceed one year<DotsRight />((<strike Parens="NoParens">$25.00</strike>)) <add>$62.00</add><paraend /><LineNumber line="38" page="3,38" hrt="no" />(3) Persons engaged in the business of the<paraend /><PageNumberFooter>		p. 3	HB 2740</PageNumberFooter><LineNumber line=" 1" page="4,1" hrt="no" />	sale, repair, or maintenance of such<paraend /><LineNumber line=" 2" page="4,2" hrt="no" />	farm implements, for any three<hyphen />month period<DotsRight />((<strike Parens="NoParens">$25.00</strike>)) <add>$62.00</add><paraend /><LineNumber line=" 3" page="4,3" hrt="no" />(4) Persons engaged in the business of the<paraend /><LineNumber line=" 4" page="4,4" hrt="no" />	sale, repair, or maintenance of such<paraend /><LineNumber line=" 5" page="4,5" hrt="no" />	farm implements, for a period not to<paraend /><LineNumber line=" 6" page="4,6" hrt="no" />	exceed one year<DotsRight />((<strike Parens="NoParens">$100.00</strike>)) <add>$250.00</add><paraend /><paraendLessSpace /><tblwrap format="narrow10ln" colmargins="zeroleftright" rowmargins="zerotopbottom"><table frame="none"><tgroup cols="6" colsep="0" rowsep="0" align="left"><colspec colname="1" colwidth="155pt" /><colspec colname="2" colwidth="103pt" /><colspec colname="3" colwidth="50pt" /><colspec colname="4" colwidth="37pt" /><colspec colname="5" colwidth="25pt" /><colspec colname="6" colwidth="26pt" /><tbody valign="top"><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line=" 7" page="4,7" hrt="no" /></entry><entry namest="2" nameend="6" align="center">Overweight Fee Schedule<paraendLessSpace /></entry></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line=" 8" page="4,8" hrt="no" /><LineNumber line=" 9" page="4,9" /></entry><entry namest="2" nameend="3">Excess weight over legal capacity,<paraend />as provided in RCW 46.44.041.<paraendLessSpace /></entry><entry namest="4" nameend="6" align="right">Cost per mile.<paraendLessSpace /></entry></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="10" page="4,10" hrt="no" /><LineNumber line="11" page="4,11" /></entry><entry align="right">0<hyphen /> 9,999 pounds</entry><entry namest="3" nameend="4"><DotsRight /></entry><entry align="right">((<strike Parens="NoParens">$</strike></entry><entry align="right"><strike Parens="NoParens">.07</strike>))<paraend addedByLN="yes" /><add>$  .10</add></entry></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="12" page="4,12" hrt="no" /><LineNumber line="13" page="4,13" /></entry><entry align="right">10,000<hyphen />14,999 pounds</entry><entry namest="3" nameend="4"><DotsRight /></entry><entry align="right">((<strike Parens="NoParens">$</strike></entry><entry align="right"><strike Parens="NoParens">.14</strike>))<paraend addedByLN="yes" /><add>$  .21</add></entry></row><row><entry align="left" forln="yes" rowsep="0" colse