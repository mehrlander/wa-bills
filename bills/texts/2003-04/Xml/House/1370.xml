<!DOCTYPE Bill PUBLIC "-//LSC//DTD Authoring Bill XML//EN" "l:\dtd\author\billauthoring.top"><Bill version="1.0" type="introLN" docName="H-0840.1"><IntroducedBillHeader><RequestNumber>H-0840.1</RequestNumber><BillNumber>HOUSE BILL 1370</BillNumber><StateLegSession><State>State of Washington</State><Legislature>58th Legislature</Legislature><Session>2003 Regular Session</Session></StateLegSession><Sponsors>Representatives Armstrong, Condotta and Ericksen</Sponsors><IntroHistory><ReadDate>Read first time 01/23/2003.  </ReadDate><ReferredTo>Referred to Committee on State Government.</ReferredTo></IntroHistory></IntroducedBillHeader><BriefDescription>Establishing a state centennial song.</BriefDescription><BillBody><PullFooter logNumber="H-0840.1/03" attorneyInitials="RJS" typistInitials="rmh" dateCreated="01/20/2003"/><BillTitle><LineNumber line=" 1" page="1,1" hrt="no"/>	AN ACT Relating to establishing a state centennial song; and adding<LineNumber line=" 2" page="1,2"/>a new section to chapter 1.20 RCW.</BillTitle><EnactingClause><LineNumber line=" 3" page="1,3" hrt="no"/>BE IT ENACTED BY THE LEGISLATURE OF THE STATE OF WASHINGTON:</EnactingClause><BillSection type="new" clausetype="newsinglesectoch"><LineNumber line=" 4" page="1,4" hrt="no"/><BegSecNew><NewSecText>NEW SECTION.</NewSecText><SecNum>Sec. </SecNum><BegSecText>A new section is added to chapter <NewSingleSecToCh>1.20</NewSingleSecToCh> RCW<LineNumber line=" 5" page="1,5"/>to read as follows:</BegSecText><LineNumber line=" 6" page="1,6" hrt="no"/></BegSecNew><RCWSLText>	The legislature hereby designates the song, music, and lyrics to<LineNumber line=" 7" page="1,7"/>&quot;Washington My Homeland,&quot; composed by Cary J. Sand, as the official<LineNumber line=" 8" page="1,8"/>state centennial song.</RCWSLText></BillSection><BillEnd>--- END ---<PageNumberFooter lastpage="yes">		p. 1	HB 1370</PageNumberFooter></BillEnd></BillBody></Bill>