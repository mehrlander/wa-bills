lign="center" /><entry align="center" /><entry align="center" /></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="11" page="4,11" hrt="no" /></entry><entry>(p) Herring gill net</entry><entry align="center">$175</entry><entry align="center">$275</entry><entry align="center">Yes</entry><entry align="center">Yes</entry></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="12" page="4,12" hrt="no" /></entry><entry>	(RCW 77.70.120)</entry><entry align="center" /><entry align="center" /><entry align="center" /><entry align="center" /></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="13" page="4,13" hrt="no" /></entry><entry>(q) Herring Lampara</entry><entry align="center">$175</entry><entry align="center">$275</entry><entry align="center">Yes</entry><entry align="center">Yes</entry></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="14" page="4,14" hrt="no" /></entry><entry>	(RCW 77.70.120)</entry><entry align="center" /><entry align="center" /><entry align="center" /><entry align="center" /></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="15" page="4,15" hrt="no" /></entry><entry>(r) Herring purse seine</entry><entry align="center">$175</entry><entry align="center">$275</entry><entry align="center">Yes</entry><entry align="center">Yes</entry></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="16" page="4,16" hrt="no" /></entry><entry>	(RCW 77.70.120)</entry><entry align="center" /><entry align="center" /><entry align="center" /><entry align="center" /></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="17" page="4,17" hrt="no" /><LineNumber line="18" page="4,18" /></entry><entry morerows="1"><HangingIndent />(s) Herring spawn<hyphen />on<hyphen eol="yes" />kelp (RCW<paraend addedByLN="yes" />	77.70.210)</entry><entry align="center">N/A</entry><entry align="center">N/A</entry><entry align="center">Yes</entry><entry align="center">Yes</entry></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="19" page="4,19" hrt="no" /></entry><entry align="center" /><entry align="center" /><entry align="center" /><entry align="center" /></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="20" page="4,20" hrt="no" /><LineNumber line="21" page="4,21" /><LineNumber line="22" page="4,22" /></entry><entry><HangingIndent />(t) <add>Sardine purse seine<paraend addedByLN="yes" />	(section 2 of this<paraend addedByLN="yes" />	act)</add></entry><entry align="center"><add>$185</add></entry><entry align="center"><add>$295</add></entry><entry align="center"><add>Yes</add></entry><entry align="center"><add>Yes</add></entry></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="23" page="4,23" hrt="no" /><LineNumber line="24" page="4,24" /><LineNumber line="25" page="4,25" /><LineNumber line="26" page="4,26" /></entry><entry><HangingIndent /><add>(u) Sardine purse seine<paraend addedByLN="yes" />	temporary<paraend addedByLN="yes" />	(section 2 of this<paraend addedByLN="yes" />	act)</add></entry><entry align="center"><add>$185</add></entry><entry align="center"><add>$295</add></entry><entry align="center"><add>Yes</add></entry><entry align="center"><add>No</add></entry></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="27" page="4,27" hrt="no" /></entry><entry><add>(v)</add> Smelt dip bag net</entry><entry align="center">$130</entry><entry align="center">$185</entry><entry align="center">No</entry><entry align="center">No</entry></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="28" page="4,28" hrt="no" /><LineNumber line="29" page="4,29" /></entry><entry><HangingIndent />((<strike>(u)</strike>)) <add>(w)</add> Smelt gill<paraend addedByLN="yes" />	net</entry><entry align="center">$380</entry><entry align="center">$685</entry><entry align="center">Yes</entry><entry align="center">No</entry></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="30" page="4,30" hrt="no" /></entry><entry morerows="1">((<strike><HangingIndent />(v)</strike>)) <add>(x)</add> Whiting<hyphen />Puget<paraend addedByLN="yes" />	Sound (RCW<paraend addedByLN="yes" />	77.70.130)</entry><entry align="center">$295</entry><entry morerows="1" align="center">$520<paraend /></entry><entry morerows="1" align="center">Yes<paraend /></entry><entry align="center">Yes</entry></row><row><entry align="left" forln="yes" rowsep="0" colsep="0"><LineNumber line="31" page="4,31" hrt="no" /></entry><entry align="center" /><entry align="center" /></row></tbody></tgroup></table></tblwrap><paraendLessSpace /><LineNumber line="32" page="4,32" hrt="no" />	(2) The director may by rule determine the species of food fish<LineNumber line="33" page="4,33" />that may be taken with the commercial fishery licenses established in<LineNumber line="34" page="4,34" />this section, the gear that may be used with the licenses, and the<LineNumber line="35" page="4,35" />areas or waters in which the licenses may be used.  Where a fishery<LineNumber line="36" page="4,36" />license has been established for a particular species, gear,<LineNumber line="37" page="4,37" />geographical area, or combination thereof, a more general fishery<LineNumber line="38" page="4,38" />license may not be used to take food fish in that fishery.</RCWSLText></BillSection><BillEnd>--- END ---<PageNumberFooter lastpage="yes">	SB 5269	p. 4	</PageNumberFooter></BillEnd></BillBody></Bill>