<!DOCTYPE Bill PUBLIC "-//LSC//DTD Authoring Bill XML//EN" "l:\dtd\author\billauthoring.top"><Bill version="1.0" type="introLN" docName="S-1403.1"><IntroducedBillHeader><RequestNumber>S-1403.1</RequestNumber><BillNumber>SENATE BILL 5857</BillNumber><StateLegSession><State>State of Washington</State><Legislature>60th Legislature</Legislature><Session>2007 Regular Session</Session></StateLegSession><Sponsors>Senators Jacobsen and Kohl-Welles</Sponsors><IntroHistory><ReadDate>Read first time 02/05/2007.  </ReadDate><ReferredTo>Referred to Committee on Government Operations &amp; Elections.</ReferredTo></IntroHistory></IntroducedBillHeader><BriefDescription>Designating the official Nordic Museum.</BriefDescription><BillBody><BillTitle><LineNumber line=" 1" page="1,1" hrt="no"/>	AN ACT Relating to the Nordic Heritage Museum; and adding a new<LineNumber line=" 2" page="1,2"/>section to chapter 1.20 RCW.</BillTitle><EnactingClause><LineNumber line=" 3" page="1,3" hrt="no"/>BE IT ENACTED BY THE LEGISLATURE OF THE STATE OF WASHINGTON:</EnactingClause><BillSection type="new" clausetype="newsinglesectoch"><LineNumber line=" 4" page="1,4" hrt="no"/><BegSecNew><NewSecText>NEW SECTION.</NewSecText><SecNum>Sec. </SecNum><BegSecText>A new section is added to chapter <NewSingleSecToCh>1.20</NewSingleSecToCh> RCW<LineNumber line=" 5" page="1,5"/>to read as follows:</BegSecText><LineNumber line=" 6" page="1,6" hrt="no"/></BegSecNew><RCWSLText>	The Nordic Heritage Museum in Seattle is hereby designated as the<LineNumber line=" 7" page="1,7"/>official Nordic museum of the state of Washington.</RCWSLText></BillSection><BillEnd>--- END ---<PageNumberFooter lastpage="yes">		p. 1	SB 5857</PageNumberFooter></BillEnd></BillBody></Bill>